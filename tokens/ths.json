{
  "$meta": {
    "theme": "ths",
    "value-forms": {
      "字符串": "所有模式/端同值",
      "{light, dark}": "亮/暗模式分叉",
      "{mobile, pc}": "端分叉（格内可再嵌套 light/dark）",
      "\"{token-name}\"": "别名引用，构建时输出 var(--token-name)"
    },
    "notes": [
      "系列色板未纳入，待色板组方案定稿",
      "spacing-legend-container 原表复合值「上下 4 · 左右 0」已拆为 -v-top / -v-bottom / -h；下间距定 12（图例与 grid 的间距，frame 不另垫）",
      "size-donut-container 原表 160×160 为正方形，记单值",
      "「行高规则 > 字号」等非数值规则不属于 token，见规范文档"
    ]
  },

  "$section-01": "涨跌与平盘语义色",
  "color-price-up": "#FF2436",
  "color-price-down": "#07AB4B",
  "color-price-even": { "light": "rgba(0, 0, 0, 0.84)", "dark": "rgba(255, 255, 255, 0.84)" },

  "$section-02": "字体家族",
  "font-family-number": "THSJinRongTi",
  "font-family-cn": "system-ui,-apple-system,Noto Sans,San Francisco,BlinkMacSystemFont,Helvetica Neue,Helvetica,sans-serif",
  "font-family-en": "{font-family-cn}",

  "$section-03": "字号阶梯",
  "font-size-super-large": "24px",
  "font-size-extra-large": "20px",
  "font-size-large": "18px",
  "font-size-base": "16px",
  "font-size-medium": "14px",
  "font-size-small": "13px",
  "font-size-extra-small": "12px",
  "font-size-super-small": "11px",
  "font-size-xxs": "10px",
  "font-size-xxxs": "9px",

  "$section-04": "行高阶梯",
  "line-height-super-large": "30px",
  "line-height-extra-large": "24px",
  "line-height-large": "22px",
  "line-height-base": "20px",
  "line-height-medium": "18px",
  "line-height-small": "16px",
  "line-height-extra-small": "14px",
  "line-height-super-small": "12px",
  "line-height-xxs": "10px",

  "$section-05": "字重阶梯",
  "font-weight-regular": 400,
  "font-weight-medium": 500,
  "font-weight-bold": 600,

  "$section-06": "圆角阶梯",
  "radius-0": "0px",
  "radius-1": "1px",
  "radius-2": "2px",
  "radius-4": "4px",
  "radius-6": "6px",
  "radius-8": "8px",
  "radius-10": "10px",
  "radius-12": "12px",
  "radius-14": "14px",
  "radius-16": "16px",
  "radius-full": "50%",

  "$section-07": "间距阶梯",
  "spacing-0": "0px",
  "spacing-2": "2px",
  "spacing-4": "4px",
  "spacing-6": "6px",
  "spacing-8": "8px",
  "spacing-10": "10px",
  "spacing-12": "12px",
  "spacing-14": "14px",
  "spacing-16": "16px",
  "spacing-20": "20px",
  "spacing-24": "24px",

  "$section-08": "坐标轴",
  "font-size-axis": { "mobile": "10px", "pc": "12px" },
  "line-height-axis": "12px",
  "font-weight-axis": "{font-weight-medium}",
  "color-text-axis": { "light": "rgba(0, 0, 0, 0.6)", "dark": "rgba(255, 255, 255, 0.6)" },
  "spacing-axis-y-inset-gap": "{spacing-8}",
  "spacing-axis-x-label-min-gap": "{spacing-8}",

  "$section-09": "通用文字颜色",
  "color-text-primary": { "light": "rgba(0, 0, 0, 0.84)", "dark": "rgba(255, 255, 255, 0.84)" },
  "color-text-secondary": { "light": "rgba(0, 0, 0, 0.6)", "dark": "rgba(255, 255, 255, 0.6)" },
  "color-text-tertiary": { "light": "rgba(0, 0, 0, 0.4)", "dark": "rgba(255, 255, 255, 0.4)" },
  "color-text-quaternary": { "light": "rgba(0, 0, 0, 0.24)", "dark": "rgba(255, 255, 255, 0.24)" },
  "color-text-inverse": "#ffffff",
  "color-text-inverse-primary": "rgba(255, 255, 255, 0.84)",
  "color-text-inverse-secondary": "rgba(255, 255, 255, 0.6)",
  "color-text-inverse-quaternary": "rgba(255, 255, 255, 0.24)",
  "color-text-link": "#4167D9",

  "$section-10": "可视化分割线、背景与高亮反馈",
  "color-visualization-divider": { "light": "rgba(0, 0, 0, 0.06)", "dark": "rgba(255, 255, 255, 0.06)" },
  "color-visualization-divider-deep": "{color-visualization-divider}",
  "color-background-weak": { "light": "rgba(0, 0, 0, 0.04)", "dark": "rgba(255, 255, 255, 0.06)" },

  "color-visualization-tooltip": "#3B3B3B",
  "color-text-tooltip-title": "rgba(255, 255, 255, 0.6)",
  "color-text-tooltip-series": "rgba(255, 255, 255, 0.84)",
  "color-text-tooltip-value": "rgba(255, 255, 255, 0.84)",
  "color-visualization-highlight-line": { "light": "rgba(0, 0, 0, 0.6)", "dark": "rgba(255, 255, 255, 0.6)" },
  "color-visualization-highlight-block": { "light": "rgba(0, 0, 0, 0.1)", "dark": "rgba(255, 255, 255, 0.1)" },
  "color-visualization-highlight-background-tick": "#3366FF",
  "color-text-highlight-tick": "#ffffff",

  "$section-11": "提示框 Tooltip",
  "font-size-tooltip": "12px",
  "font-family-tooltip": "{font-family-cn}",
  "font-weight-tooltip-value": "{font-weight-medium}",
  "spacing-tooltip-pad": "{spacing-8}",
  "spacing-tooltip-row": "{spacing-4}",
  "spacing-tooltip-row-gap": "{spacing-12}",
  "radius-tooltip": "{radius-4}",
  "size-tooltip-max-width": "160px",
  "color-visualization-tooltip-border": "transparent",
  "shadow-tooltip": "none",
  "color-visualization-tooltip-divider": "transparent",
  "dash-highlight-line": "none",
  "radius-axis-label-tag": "{radius-2}",
  "spacing-axis-label-tag-pad-h": "1px",
  "tooltip-hide-delay": "2000ms",

  "$section-12": "图例",
  "font-size-legend": "12px",
  "line-height-legend": "16px",
  "color-text-legend": { "light": "rgba(0, 0, 0, 0.6)", "dark": "rgba(255, 255, 255, 0.6)" },
  "size-legend-marker": "12px",
  "spacing-legend-marker-label": "{spacing-2}",
  "spacing-legend-item-h": "{spacing-12}",
  "spacing-legend-item-v": "{spacing-12}",
  "spacing-legend-row-v": "{spacing-4}",
  "spacing-legend-container-v-top": "{spacing-4}",
  "spacing-legend-container-v-bottom": "{spacing-12}",
  "spacing-legend-chart-gap": "{spacing-24}",
  "spacing-legend-container-h": "{spacing-0}",
  "opacity-visualization-dim": 0.2,

  "$section-13": "缩放轴 Axes Navigator",
  "color-datazoom-filler": "rgba(51, 102, 255, 0.08)",
  "color-datazoom-data-bg": { "light": "rgba(0, 0, 0, 0.08)", "dark": "rgba(255, 255, 255, 0.12)" },
  "color-datazoom-data-select": "rgba(51, 102, 255, 0.16)",
  "color-datazoom-handle": { "light": "#FFFFFF", "dark": "#3B3B3B" },
  "color-datazoom-handle-border": { "light": "rgba(0, 0, 0, 0.2)", "dark": "rgba(255, 255, 255, 0.2)" },
  "color-datazoom-handle-grip": "#858585",
  "shadow-datazoom-handle": "none",
  "size-slider-height": "24px",
  "size-slider-handle-border": "0.5px",
  "radius-slider-handle": "{radius-6}",
  "radius-slider-mask": "{radius-6}",

  "$section-14": "中性灰阶",
  "color-grey-01": { "light": "#E6E6E6", "dark": "#292929" },
  "color-grey-02": { "light": "#D1D1D1", "dark": "#3B3B3B" },
  "color-grey-03": { "light": "#B3B3B3", "dark": "#575757" },
  "color-grey-04": { "light": "#9C9C9C", "dark": "#6E6E6E" },
  "color-grey-05": "#858585",

  "$section-15": "图表公共区域、网格与引导线",
  "size-chart-region-height": "160px",
  "size-grid-line": { "mobile": "0.5px", "pc": "1px" },
  "spacing-chart-region-gap": "{spacing-8}",
  "spacing-leader-line-offset": "{spacing-8}",

  "$section-16": "柱状图 Bar",
  "size-bar-max": "16px",
  "size-bar-container-max": "24px",
  "size-bar-gap-ratio": "2:1",
  "radius-bar-top": "{radius-2}",
  "radius-bar-top-reduced": "{radius-1}",
  "size-bar-radius-full-min-width": "8px",
  "size-bar-radius-reduced-min-width": "4px",
  "size-zero-bar-placeholder": "1px",

  "$section-17": "分组柱状图 Grouped Bar",
  "size-bar-group-gap-ratio": "2:1",
  "size-bar-group-container-max": "none",
  "size-bar-group-inner-gap-max": "2px",

  "$section-18": "折线图 Line",
  "size-line-stroke": "1.5px",
  "size-line-stroke-multi": "1px",
  "size-line-point": "6px",
  "color-visualization-line-point-hover": { "light": "#ffffff", "dark": "#000000" },
  "opacity-line-area-from": 0.2,
  "opacity-line-area-to": 0,
  "opacity-line-stack-fill": 0.2,

  "$section-19": "横向柱状图 HBar",
  "size-hbar-row-max": "24px",
  "size-hbar-y-label-max": "80px",
  "size-hbar-data-label-max": "40px",

  "$section-20": "环形图 Donut",
  "size-donut-container": "160px",
  "size-donut-radius": "70px",
  "size-donut-ring-width": "28px",
  "size-donut-hover-expand": "0px",

  "$section-21": "数据标签 Data Label",
  "color-text-data-label-on-light": "rgba(0, 0, 0, 0.84)",
  "color-text-data-label-on-dark": "{color-text-inverse-primary}",
  "font-size-data-label": "{font-size-xxs}",
  "font-weight-data-label": "{font-weight-medium}",
  "line-height-data-label": "{line-height-axis}",
  "spacing-data-label-gap": "{spacing-4}",
  "spacing-data-label-min-gap": "{spacing-4}",

  "$section-22": "轴标题 Axis Title",
  "font-size-axis-title": "{font-size-axis}",
  "line-height-axis-title": "{line-height-axis}",
  "font-weight-axis-title": "{font-weight-axis}",
  "color-text-axis-title": "{color-text-axis}",
  "spacing-axis-title-gap": "{spacing-4}",

  "$section-23": "动效 Motion",
  "motion-duration-grow": "480ms",
  "motion-duration-emphasis": "200ms"
}
