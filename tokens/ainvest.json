{
  "$meta": {
    "theme": "ainvest",
    "source": "vis-design-system lite/references/tokens.md",
    "value-forms": {
      "字符串": "所有模式/端同值",
      "{light, dark}": "亮/暗模式分叉",
      "{mobile, pc}": "端分叉（格内可再嵌套 light/dark）",
      "\"{token-name}\"": "别名引用，构建时输出 var(--token-name)"
    },
    "notes": [
      "系列色板未纳入，待色板组方案定稿",
      "涨跌语义与 A 股主题相反：绿涨红跌（值已按此录入，语义见规范文档）",
      "spacing-legend-container 原表「上下 16(app) / 12(web) · 左右 0」已拆为 -v（端分叉）/ -h",
      "size-donut-container 原表 160×160 为正方形，记单值"
    ]
  },

  "color-price-up": "#00B53C",
  "color-price-down": "#FF381A",
  "color-price-even": { "light": "#000000", "dark": "#ffffff" },

  "font-family-number": "{font-family-en}",
  "font-family-cn": "{font-family-en}",
  "font-family-en": "Ainvest Sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\",\"Segoe UI Symbol\"",

  "font-size-super-large": "24px",
  "font-size-extra-large": "20px",
  "font-size-large": "18px",
  "font-size-base": "16px",
  "font-size-medium": "14px",
  "font-size-small": "13px",
  "font-size-extra-small": "12px",
  "font-size-super-small": "11px",
  "font-size-xxs": "10px",
  "font-size-xxxs": "9px",

  "line-height-super-large": "30px",
  "line-height-extra-large": "24px",
  "line-height-large": "22px",
  "line-height-base": "20px",
  "line-height-medium": "18px",
  "line-height-small": "16px",
  "line-height-extra-small": "14px",
  "line-height-super-small": "12px",
  "line-height-xxs": "10px",

  "font-weight-regular": 400,
  "font-weight-medium": 500,
  "font-weight-bold": 600,

  "font-size-axis": { "mobile": "10px", "pc": "11px" },
  "line-height-axis": { "mobile": "12px", "pc": "16px" },
  "color-text-axis": {
    "mobile": { "light": "rgba(0, 0, 0, 0.6)", "dark": "rgba(255, 255, 255, 0.6)" },
    "pc": { "light": "#000000", "dark": "#ffffff" }
  },

  "color-text-primary": { "light": "#000000", "dark": "#ffffff" },
  "color-text-secondary": { "light": "rgba(0, 0, 0, 0.6)", "dark": "rgba(255, 255, 255, 0.6)" },
  "color-text-tertiary": { "light": "rgba(0, 0, 0, 0.4)", "dark": "rgba(255, 255, 255, 0.4)" },
  "color-text-quaternary": { "light": "rgba(0, 0, 0, 0.2)", "dark": "rgba(255, 255, 255, 0.2)" },
  "color-text-inverse": "#ffffff",
  "color-text-inverse-primary": "#ffffff",
  "color-text-inverse-secondary": "rgba(255, 255, 255, 0.6)",
  "color-text-inverse-quaternary": "rgba(255, 255, 255, 0.2)",
  "color-text-link": { "light": "#165DFF", "dark": "#3371FF" },

  "color-visualization-divider": {
    "mobile": { "light": "rgba(0, 0, 0, 0.1)", "dark": "rgba(255, 255, 255, 0.1)" },
    "pc": { "light": "rgba(0, 0, 0, 0.05)", "dark": "rgba(255, 255, 255, 0.07)" }
  },
  "color-visualization-divider-deep": "#858585",
  "color-background-weak": { "light": "rgba(0, 0, 0, 0.04)", "dark": "rgba(255, 255, 255, 0.06)" },

  "color-visualization-tooltip": "#383838",
  "color-text-tooltip-title": "#ffffff",
  "color-text-tooltip-series": "#ffffff",
  "color-text-tooltip-value": "#ffffff",
  "color-visualization-highlight-line": { "light": "rgba(0, 0, 0, 0.6)", "dark": "rgba(255, 255, 255, 0.6)" },
  "color-visualization-highlight-block": { "light": "rgba(0, 0, 0, 0.1)", "dark": "rgba(255, 255, 255, 0.1)" },
  "color-visualization-highlight-background-tick": { "light": "#000000", "dark": "#ffffff" },
  "color-text-highlight-tick": { "light": "#ffffff", "dark": "#000000" },

  "font-size-tooltip": "12px",
  "spacing-tooltip-padding": "8px",
  "spacing-tooltip-row": "4px",
  "spacing-tooltip-row-gap": "12px",
  "radius-tooltip": "4px",
  "size-tooltip-max-width": "160px",
  "radius-axis-label-tag": "4px",
  "tooltip-hide-delay": "0ms",

  "font-size-legend": "12px",
  "line-height-legend": "16px",
  "color-text-legend": { "light": "rgba(0, 0, 0, 0.6)", "dark": "rgba(255, 255, 255, 0.6)" },
  "size-legend-marker": "12px",
  "spacing-legend-marker-label": "6px",
  "spacing-legend-item-h": "16px",
  "spacing-legend-row-v": "4px",
  "spacing-legend-container-v": { "mobile": "16px", "pc": "12px" },
  "spacing-legend-container-h": "0px",

  "color-visualization-datazoom-filler": { "light": "rgba(0, 0, 0, 0.6)", "dark": "rgba(255, 255, 255, 0.6)" },
  "color-visualization-datazoom-data-bg": { "light": "rgba(0, 0, 0, 0.08)", "dark": "rgba(255, 255, 255, 0.12)" },
  "color-visualization-datazoom-data-select": "rgba(51, 102, 255, 0.16)",

  "color-grey-01": { "light": "#E6E6E6", "dark": "#292929" },
  "color-grey-02": { "light": "#D1D1D1", "dark": "#3B3B3B" },
  "color-grey-03": { "light": "#B3B3B3", "dark": "#575757" },
  "color-grey-04": { "light": "#9C9C9C", "dark": "#6E6E6E" },
  "color-grey-05": "#858585",

  "size-bar-max": "32px",
  "size-bar-container-max": "48px",
  "radius-bar-top": "0px",
  "size-line-stroke": "2px",
  "size-line-stroke-multi": "2px",
  "size-slider-height": "4px",
  "size-chart-region-height": "200px",
  "size-grid-line": { "mobile": "0.5px", "pc": "1px" },
  "size-zero-bar-placeholder": "1px",
  "spacing-leader-line-offset": "8px",

  "spacing-chart-region-gap": "8px",
  "size-bar-bar-gap-ratio": "2:1",
  "size-bar-group-container-max": "100px",
  "size-bar-group-inner-gap-max": "2px",
  "size-hbar-row-max": "24px",
  "size-hbar-y-label-max": "80px",
  "size-hbar-data-label-max": "40px",
  "size-line-point": "6px",
  "size-donut-container": "160px",
  "size-donut-radius": "70px",
  "size-donut-ring-width": "28px",
  "radius-slider-handle": "6px",
  "radius-slider-mask": "4px"
}
