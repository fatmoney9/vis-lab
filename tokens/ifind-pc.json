{
  "$meta": {
    "theme": "ifind-pc",
    "source": "vis-design-system lite/references/tokens.md",
    "value-forms": {
      "字符串": "所有模式/端同值",
      "{light, dark}": "亮/暗模式分叉",
      "{mobile, pc}": "端分叉（格内可再嵌套 light/dark）",
      "\"{token-name}\"": "别名引用，构建时输出 var(--token-name)"
    },
    "notes": [
      "系列色板未纳入，待色板组方案定稿",
      "spacing-legend-container 原表为「—（暂无）」：暂按 THS 同值 4px/0px 占位，⚠️ 待定稿",
      "color-visualization-divider 原表单值 #e9e9f2（亮暗同值），按源文件保留",
      "size-donut-container 原表 160×160 为正方形，记单值"
    ]
  },

  "$section-01": "涨跌与平盘语义色",
  "color-price-up": "#eb5454",
  "color-price-down": "#47b262",
  "color-price-even": { "light": "#4F4F5E", "dark": "#D1D1E0" },

  "$section-02": "字体家族",
  "font-family-number": "Microsoft YaHei",
  "font-family-cn": "Microsoft YaHei",
  "font-family-en": "Microsoft YaHei",

  "$section-03": "字号阶梯",
  "font-size-super-large": "24px",
  "font-size-extra-large": "20px",
  "font-size-large": "18px",
  "font-size-base": "16px",
  "font-size-medium": "14px",
  "font-size-small": "13px",
  "font-size-extra-small": "12px",
  "font-size-super-small": "11px",
  "font-size-xxs": "10px",
  "font-size-xxxs": "9px",

  "$section-04": "行高阶梯",
  "line-height-super-large": "30px",
  "line-height-extra-large": "24px",
  "line-height-large": "22px",
  "line-height-base": "20px",
  "line-height-medium": "18px",
  "line-height-small": "16px",
  "line-height-extra-small": "14px",
  "line-height-super-small": "12px",
  "line-height-xxs": "10px",

  "$section-05": "字重阶梯",
  "font-weight-regular": 400,
  "font-weight-medium": 500,
  "font-weight-bold": 600,

  "$section-06": "圆角阶梯",
  "radius-0": "0px",
  "radius-2": "2px",
  "radius-4": "4px",
  "radius-6": "6px",
  "radius-8": "8px",
  "radius-10": "10px",
  "radius-12": "12px",
  "radius-14": "14px",
  "radius-16": "16px",
  "radius-full": "50%",

  "$section-07": "间距阶梯",
  "spacing-0": "0px",
  "spacing-2": "2px",
  "spacing-4": "4px",
  "spacing-6": "6px",
  "spacing-8": "8px",
  "spacing-10": "10px",
  "spacing-12": "12px",
  "spacing-14": "14px",
  "spacing-16": "16px",
  "spacing-20": "20px",
  "spacing-24": "24px",

  "$section-08": "坐标轴",
  "font-size-axis": "14px",
  "line-height-axis": "14px",
  "font-weight-axis": "{font-weight-medium}",
  "color-text-axis": { "light": "#87879C", "dark": "#A1A1B3" },
  "spacing-axis-y-inset-gap": "{spacing-8}",
  "spacing-axis-x-label-min-gap": "{spacing-8}",

  "$section-09": "通用文字颜色",
  "color-text-primary": { "light": "#292933", "dark": "#E9E9F2" },
  "color-text-secondary": { "light": "#4F4F5E", "dark": "#D1D1E0" },
  "color-text-tertiary": { "light": "rgba(0, 0, 0, 0.4)", "dark": "rgba(255, 255, 255, 0.4)" },
  "color-text-quaternary": { "light": "rgba(0, 0, 0, 0.24)", "dark": "rgba(255, 255, 255, 0.24)" },
  "color-text-inverse": "#ffffff",
  "color-text-inverse-primary": "rgba(255, 255, 255, 0.84)",
  "color-text-inverse-secondary": "rgba(255, 255, 255, 0.6)",
  "color-text-inverse-quaternary": "rgba(255, 255, 255, 0.24)",
  "color-text-link": "#4167D9",

  "$section-10": "可视化分割线、背景与高亮反馈",
  "color-visualization-divider": "#e9e9f2",
  "color-visualization-divider-deep": { "light": "#87879C", "dark": "#A1A1B3" },
  "color-background-weak": { "light": "rgba(0, 0, 0, 0.04)", "dark": "rgba(255, 255, 255, 0.06)" },

  "color-visualization-tooltip": { "light": "rgba(255, 255, 255, 0.95)", "dark": "rgba(27, 27, 36, 0.95)" },
  "color-text-tooltip-title": { "light": "#292933", "dark": "#E9E9F2" },
  "color-text-tooltip-series": { "light": "#4F4F5E", "dark": "#D1D1E0" },
  "color-text-tooltip-value": { "light": "#4F4F5E", "dark": "#D1D1E0" },
  "color-visualization-highlight-line": "#7D7D94",
  "color-visualization-highlight-block": { "light": "rgba(0, 0, 0, 0.1)", "dark": "rgba(255, 255, 255, 0.1)" },
  "color-visualization-highlight-background-tick": { "light": "#D1D1E0", "dark": "#4F4F5E" },
  "color-text-highlight-tick": { "light": "#292933", "dark": "#E9E9F2" },

  "$section-11": "提示框 Tooltip",
  "font-size-tooltip": "14px",
  "spacing-tooltip-padding": "{spacing-8}",
  "spacing-tooltip-row": "{spacing-4}",
  "spacing-tooltip-row-gap": "{spacing-12}",
  "radius-tooltip": "{radius-4}",
  "size-tooltip-max-width": "160px",
  "radius-axis-label-tag": "{radius-4}",
  "tooltip-hide-delay": "2000ms",

  "$section-12": "图例",
  "font-size-legend": "14px",
  "line-height-legend": "14px",
  "color-text-legend": { "light": "#4F4F5E", "dark": "#D1D1E0" },
  "size-legend-marker": "12px",
  "spacing-legend-marker-label": "{spacing-6}",
  "spacing-legend-item-h": "{spacing-20}",
  "spacing-legend-row-v": "{spacing-4}",
  "spacing-legend-container-v": "{spacing-4}",
  "spacing-legend-container-h": "{spacing-0}",
  "opacity-visualization-dim": 0.1,

  "$section-13": "缩放轴 Axes Navigator",
  "color-visualization-datazoom-filler": "rgba(95, 146, 228, 0.2)",
  "color-visualization-datazoom-data-bg": { "light": "rgba(0, 0, 0, 0.08)", "dark": "rgba(255, 255, 255, 0.12)" },
  "color-visualization-datazoom-data-select": "rgba(51, 102, 255, 0.16)",
  "size-slider-height": "16px",
  "radius-slider-handle": "{radius-6}",
  "radius-slider-mask": "{radius-4}",

  "$section-14": "中性灰阶",
  "color-grey-01": { "light": "#E6E6E6", "dark": "#292929" },
  "color-grey-02": { "light": "#D1D1D1", "dark": "#3B3B3B" },
  "color-grey-03": { "light": "#B3B3B3", "dark": "#575757" },
  "color-grey-04": { "light": "#9C9C9C", "dark": "#6E6E6E" },
  "color-grey-05": "#858585",

  "$section-15": "图表公共区域、网格与引导线",
  "size-chart-region-height": "160px",
  "size-grid-line": { "mobile": "0.5px", "pc": "1px" },
  "spacing-chart-region-gap": "{spacing-8}",
  "spacing-leader-line-offset": "{spacing-8}",

  "$section-16": "柱状图 Bar",
  "size-bar-max": "32px",
  "size-bar-container-max": "48px",
  "size-bar-gap-ratio": "2:1",
  "radius-bar-top": "{radius-0}",
  "size-zero-bar-placeholder": "1px",

  "$section-17": "分组柱状图 Grouped Bar",
  "size-bar-group-gap-ratio": "2:1",
  "size-bar-group-container-max": "100px",
  "size-bar-group-inner-gap-max": "2px",

  "$section-18": "折线图 Line",
  "size-line-stroke": "2px",
  "size-line-stroke-multi": "2px",
  "size-line-point": "6px",
  "opacity-line-area-from": 0.2,
  "opacity-line-area-to": 0,
  "opacity-line-stack-fill": 0.2,

  "$section-19": "横向柱状图 HBar",
  "size-hbar-row-max": "24px",
  "size-hbar-y-label-max": "80px",
  "size-hbar-data-label-max": "40px",

  "$section-20": "环形图 Donut",
  "size-donut-container": "160px",
  "size-donut-radius": "70px",
  "size-donut-ring-width": "28px"
}
