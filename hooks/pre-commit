#!/bin/sh
# 提交前：跑 hooks/check.sh 的全部检查，并把重新生成的产物一并纳入本次提交，
# 保证 tokens.css / watermark-assets.js 永不与源脱节。
#
# 检查清单本身不在这里——住在 hooks/check.sh（唯一一份，CI 调的是同一个脚本）。
# 因此「本地过了 CI 挂了」只可能来自环境差异（node 版本、大小写敏感的文件系统）
# 或漏提交生成物，不会再来自两边清单不一致。
#
# 安装（每个克隆一次）：git config core.hooksPath hooks
set -e

# 成功时保持安静、失败时打出完整输出——提交流程里刷屏没有意义，但失败信息一个字都不能吞。
out=$(sh hooks/check.sh 2>&1) || { printf '%s\n' "$out" >&2; exit 1; }

# 生成物随源一起进提交；CI 侧用 --verify 只验不改，两边合起来才保证不脱节。
git add tokens/tokens.css charts/core/watermark-assets.js
