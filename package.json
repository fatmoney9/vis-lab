{
  "name": "vis-lab",
  "version": "0.0.0",
  "private": true,
  "description": "design token 驱动的可视化规范站。本文件只登记命令：零依赖、无需 npm install，每条脚本都能直接手敲。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "sh hooks/check.sh",
    "check:ci": "sh hooks/check.sh --verify",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "build:tokens": "node tokens/build.mjs",
    "build:watermark": "node assets/build-watermark-assets.mjs",
    "preview": "python3 -m http.server 8123"
  }
}
